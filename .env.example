# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (from Developer Portal)
CLIENT_ID=your_client_id_here

# Your Discord Server (Guild) ID
GUILD_ID=your_guild_id_here

# The channel ID of a private bot-database channel you create
# Create a channel called #bot-database, make it private (only bot can see), copy ID here
DATABASE_CHANNEL_ID=your_database_channel_id_here
